# Copy this file to .env and fill in your values. The .env file is gitignored.
# Hugging Face access token with read scope: https://huggingface.co/settings/tokens
# Optional: the models are public; a token only lifts the Hub's rate limits.
HF_TOKEN=

# Where the converted models and the run lock live
# (default ~/.cache/granite-document-intelligence). Leave unset to use the default.
# GDI_CACHE_DIR=
