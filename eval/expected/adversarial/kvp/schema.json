{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purchase order",
  "type": "object",
  "properties": {
    "po_number": {"type": "string", "description": "The purchase order number"},
    "order_date": {"type": "string", "description": "The order date as printed"},
    "vendor": {"type": "string", "description": "The vendor's name"},
    "ship_to": {"type": "string", "description": "The ship-to address"},
    "total_due": {"type": "string", "description": "The total due, as printed"}
  },
  "required": ["po_number", "order_date", "vendor", "ship_to", "total_due"],
  "additionalProperties": false
}
